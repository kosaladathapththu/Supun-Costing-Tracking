rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCfo() {
      return signedIn() && request.auth.token.email == 'cfo@supungroup.lk';
    }

    match /appData/{section} {
      allow read: if signedIn();
      allow create, update, delete: if isCfo();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
