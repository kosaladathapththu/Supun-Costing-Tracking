rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function signedIn(){ return request.auth != null; } function admin(){ return signedIn() && request.auth.token.role in ['admin','cfo']; } match /{document=**} { allow read: if signedIn(); allow write: if admin() || (signedIn() && request.auth.token.role == 'costing_officer'); } match /auditLogs/{id} { allow create: if signedIn(); allow update, delete: if false; } } }
